@app.get("/vehicles/profitability")
def vehicle_profitability(
    limit: int = Query(
        default=25,
        ge=1,
        le=100,
    )
):
    """
    Return daily vehicle profitability reconciliation.
    """

    conn = None

    try:
        conn = get_connection()

        query = """
            SELECT
                vehicle_id,
                report_date,
                earnings,
                fuel_cost,
                maintenance_cost,
                operating_cost,
                profit,
                profit_margin,
                distance_covered,
                service_flag,
                profitability_status,
                calculated_at
            FROM vehicle_profitability
            ORDER BY
                report_date DESC,
                vehicle_id
            LIMIT %s;
        """

        with conn.cursor() as cursor:
            cursor.execute(query, (limit,))
            rows = cursor.fetchall()

        result = []

        for row in rows:
            result.append(
                {
                    "vehicle_id": row[0],
                    "report_date": row[1],
                    "earnings": float(row[2] or 0),
                    "fuel_cost": float(row[3] or 0),
                    "maintenance_cost": float(row[4] or 0),
                    "operating_cost": float(row[5] or 0),
                    "profit": float(row[6] or 0),
                    "profit_margin": (
                        float(row[7])
                        if row[7] is not None
                        else None
                    ),
                    "distance_covered": float(
                        row[8] or 0
                    ),
                    "service_flag": row[9],
                    "profitability_status": row[10],
                    "calculated_at": row[11],
                }
            )

        return result

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )

    finally:
        if conn:
            conn.close()


