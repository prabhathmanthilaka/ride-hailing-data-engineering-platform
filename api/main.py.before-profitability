# FLEET UTILIZATION
# ============================================================

@app.get("/fleet/utilization")
def fleet_utilization():
    """
    Return current fleet utilization by zone.
    """

    conn = None

    try:
        conn = get_connection()

        query = f"""
            WITH latest_vehicle_state AS (
                SELECT DISTINCT ON (vehicle_id)
                    vehicle_id,
                    zone,
                    status,
                    event_timestamp
                FROM telemetry_events
                WHERE zone IS NOT NULL
                ORDER BY vehicle_id, event_timestamp DESC
            ),

            zone_states AS (
                SELECT
                    zone,

                    COUNT(*) FILTER (
                        WHERE status IN ('idle', 'enroute', 'on_trip')
                    ) AS active_vehicles,

                    COUNT(*) FILTER (
                        WHERE status = 'idle'
                    ) AS idle_vehicles,

                    COUNT(*) FILTER (
                        WHERE status = 'enroute'
                    ) AS enroute_vehicles,

                    COUNT(*) FILTER (
                        WHERE status = 'on_trip'
                    ) AS on_trip_vehicles

                FROM latest_vehicle_state
                GROUP BY zone
            ),

            {TRIP_FINAL_FARE_CTE},

            zone_activity AS (
                SELECT
                    zone,
                    COUNT(*) AS trips,
                    COALESCE(SUM(fare), 0) AS earnings
                FROM trip_final
                GROUP BY zone
            )

            SELECT
                zs.zone,
                zs.active_vehicles,
                zs.idle_vehicles,
                zs.enroute_vehicles,
                zs.on_trip_vehicles,

                CASE
                    WHEN zs.active_vehicles > 0
                    THEN ROUND(
                        zs.idle_vehicles::numeric
                        / zs.active_vehicles,
                        4
                    )
                    ELSE 0
                END AS idle_ratio,

                COALESCE(za.trips, 0) AS trips,
                COALESCE(za.earnings, 0) AS earnings

            FROM zone_states zs

            LEFT JOIN zone_activity za
                ON zs.zone = za.zone

            ORDER BY zs.zone;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        result = []

        for row in rows:
            result.append(
                {
                    "zone": row[0],
                    "active_vehicles": row[1],
                    "idle_vehicles": row[2],
                    "enroute_vehicles": row[3],
                    "on_trip_vehicles": row[4],
                    "idle_ratio": float(row[5] or 0),
                    "trips": row[6],
                    "earnings": float(row[7] or 0),
                }
            )

        return result

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )

    finally:
        if conn:
            conn.close()


