@app.get("/alerts")
def alerts():
    """
    Return vehicles that currently require service attention.
    """

    conn = None

    try:
        conn = get_connection()

        query = """
            SELECT
                vehicle_id,
                report_date,
                service_flag,
                profitability_status,
                profit,
                profit_margin
            FROM vehicle_profitability
            WHERE service_flag <> 'OK'
               OR profitability_status IN (
                    'AT_RISK',
                    'UNPROFITABLE'
               )
            ORDER BY
                report_date DESC,
                vehicle_id;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        result = []

        for row in rows:
            result.append(
                {
                    "vehicle_id": row[0],
                    "report_date": row[1],
                    "service_flag": row[2],
                    "profitability_status": row[3],
                    "profit": float(row[4] or 0),
                    "profit_margin": (
                        float(row[5])
                        if row[5] is not None
                        else None
                    ),
                }
            )

        return result

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )

    finally:
        if conn:
            conn.close()


