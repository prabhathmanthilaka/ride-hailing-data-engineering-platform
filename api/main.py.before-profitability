@app.on_event("startup")
def initialize_health_metrics():
    """
    Initialize API and database health metrics when the API starts.

    The API is considered healthy once FastAPI starts successfully.
    PostgreSQL connectivity is checked separately.
    """

    API_HEALTH_STATUS.set(1)

    try:
        conn = psycopg2.connect(
            host=os.getenv("POSTGRES_HOST", "localhost"),
            port=os.getenv("POSTGRES_PORT", "5432"),
            dbname=os.getenv("POSTGRES_DB", "ride_hailing"),
            user=os.getenv("POSTGRES_USER", "ride_admin"),
            password=os.getenv("POSTGRES_PASSWORD", "ride_password"),
            connect_timeout=5,
        )

        conn.close()

        DATABASE_HEALTH_STATUS.set(1)

    except Exception:
        DATABASE_HEALTH_STATUS.set(0)


# ============================================================
# FLEET PROMETHEUS METRIC REFRESH
# ============================================================

def update_fleet_prometheus_metrics():
    """
    Refresh fleet Prometheus gauges from the latest vehicle state
    stored in PostgreSQL.

    Each vehicle contributes only its most recent telemetry event.
    Metrics are grouped by the vehicle's current zone.
    """

    conn = None

    try:
        conn = get_connection()

        query = """
            SELECT
                zone,
                COUNT(*) FILTER (
                    WHERE status IN ('idle', 'enroute', 'on_trip')
                ) AS active_vehicles,

                COUNT(*) FILTER (
                    WHERE status = 'idle'
                ) AS idle_vehicles,

                COUNT(*) FILTER (
                    WHERE status = 'enroute'
                ) AS enroute_vehicles,

                COUNT(*) FILTER (
                    WHERE status = 'on_trip'
                ) AS on_trip_vehicles

            FROM (
                SELECT DISTINCT ON (vehicle_id)
                    vehicle_id,
                    zone,
                    status,
                    event_timestamp

                FROM telemetry_events

                WHERE zone IS NOT NULL

                ORDER BY
                    vehicle_id,
                    event_timestamp DESC
            ) latest_vehicle_state

            GROUP BY zone

            ORDER BY zone;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        # Remove previous zone label values so that stale zones
        # cannot remain in Prometheus.
        FLEET_ACTIVE_VEHICLES.clear()
        FLEET_IDLE_VEHICLES.clear()
        FLEET_ENROUTE_VEHICLES.clear()
        FLEET_ON_TRIP_VEHICLES.clear()

        for row in rows:
            zone = row[0]

            FLEET_ACTIVE_VEHICLES.labels(
                zone=zone
            ).set(row[1] or 0)

            FLEET_IDLE_VEHICLES.labels(
                zone=zone
            ).set(row[2] or 0)

            FLEET_ENROUTE_VEHICLES.labels(
                zone=zone
            ).set(row[3] or 0)

            FLEET_ON_TRIP_VEHICLES.labels(
                zone=zone
            ).set(row[4] or 0)

    except Exception as exc:
        print(
            f"FLEET_METRICS_UPDATE_ERROR error={exc}"
        )

    finally:
        if conn:
            conn.close()


# ============================================================
# EARNINGS PROMETHEUS METRIC REFRESH
# ============================================================

def update_earnings_prometheus_metrics():
    """
    Refresh trips/earnings gauges by zone and time of day.

    Each trip contributes only its final (maximum) fare.
    """

    conn = None

    try:
        conn = get_connection()

        query = f"""
            WITH {TRIP_FINAL_FARE_CTE}

            SELECT
                zone,
                time_of_day,
                COUNT(*) AS trips,
                COALESCE(SUM(fare), 0) AS earnings
            FROM trip_final
            GROUP BY zone, time_of_day
            ORDER BY zone, time_of_day;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        # Remove previous label values so that stale
        # zone/time_of_day combinations cannot remain.
        FLEET_TRIPS_TOTAL.clear()
        FLEET_EARNINGS_TOTAL.clear()

        for zone, time_of_day, trips, earnings in rows:

            FLEET_TRIPS_TOTAL.labels(
                zone=zone,
                time_of_day=time_of_day,
            ).set(trips or 0)

            FLEET_EARNINGS_TOTAL.labels(
                zone=zone,
                time_of_day=time_of_day,
            ).set(float(earnings or 0))

    except Exception as exc:
        print(
            f"EARNINGS_METRICS_UPDATE_ERROR error={exc}"
        )

    finally:
        if conn:
            conn.close()


