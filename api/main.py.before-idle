import os
from datetime import datetime, timezone
from time import perf_counter

import psycopg2
from fastapi import FastAPI, HTTPException, Query, Request
from fastapi.responses import Response
from prometheus_client import (
    CONTENT_TYPE_LATEST,
    Counter,
    Gauge,
    Histogram,
    generate_latest,
)

from database import get_connection

app = FastAPI(
    title="Ride-Hailing Fleet Operations API",
    description="Serving API for real-time fleet utilization, earnings, profitability and alerts.",
    version="1.0.0",
)


# ============================================================
# PROMETHEUS METRICS
# ============================================================

API_REQUESTS_TOTAL = Counter(
    "ride_api_requests_total",
    "Total number of API requests.",
    ["method", "endpoint", "status"],
)

API_REQUEST_DURATION = Histogram(
    "ride_api_request_duration_seconds",
    "API request processing duration in seconds.",
    ["method", "endpoint"],
)

API_HEALTH_STATUS = Gauge(
    "ride_api_health_status",
    "API health status. 1 means healthy, 0 means unhealthy.",
)

DATABASE_HEALTH_STATUS = Gauge(
    "ride_api_database_status",
    "Database connectivity status. 1 means healthy, 0 means unhealthy.",
)


# ============================================================
# FLEET BUSINESS METRICS
# ============================================================

FLEET_ACTIVE_VEHICLES = Gauge(
    "ride_fleet_active_vehicles",
    "Number of active vehicles by zone.",
    ["zone"],
)

FLEET_IDLE_VEHICLES = Gauge(
    "ride_fleet_idle_vehicles",
    "Number of idle vehicles by zone.",
    ["zone"],
)

FLEET_ENROUTE_VEHICLES = Gauge(
    "ride_fleet_enroute_vehicles",
    "Number of enroute vehicles by zone.",
    ["zone"],
)

FLEET_ON_TRIP_VEHICLES = Gauge(
    "ride_fleet_on_trip_vehicles",
    "Number of vehicles currently on a trip by zone.",
    ["zone"],
)


# ============================================================
# EARNINGS / TRIPS BUSINESS METRICS
# ============================================================

FLEET_TRIPS_TOTAL = Gauge(
    "ride_fleet_trips_total",
    "Number of trips by zone and time of day.",
    ["zone", "time_of_day"],
)

FLEET_EARNINGS_TOTAL = Gauge(
    "ride_fleet_earnings_total",
    "Trip earnings by zone and time of day (final fare per trip).",
    ["zone", "time_of_day"],
)


# ============================================================
# PROFITABILITY BUSINESS METRICS (LATEST RECONCILED DAY)
# ============================================================

VEHICLE_PROFIT = Gauge(
    "ride_vehicle_profit",
    "Vehicle profit (earnings - fuel - maintenance) for the latest reconciled day.",
    ["vehicle_id"],
)

VEHICLE_PROFIT_MARGIN = Gauge(
    "ride_vehicle_profit_margin",
    "Vehicle profit margin in percent for the latest reconciled day.",
    ["vehicle_id"],
)

VEHICLES_BY_PROFITABILITY_STATUS = Gauge(
    "ride_vehicles_by_profitability_status",
    "Number of vehicles per profitability status for the latest reconciled day.",
    ["status"],
)

VEHICLES_SERVICE_REQUIRED = Gauge(
    "ride_vehicles_service_required",
    "Number of vehicles flagged SERVICE_REQUIRED on the latest reconciled day.",
)

FLEET_DAILY_EARNINGS = Gauge(
    "ride_fleet_daily_earnings",
    "Fleet earnings for the latest reconciled day.",
)

FLEET_DAILY_OPERATING_COST = Gauge(
    "ride_fleet_daily_operating_cost",
    "Fleet fuel + maintenance cost for the latest reconciled day.",
)

PROFITABILITY_REPORT_DATE = Gauge(
    "ride_profitability_report_date_timestamp",
    "Latest reconciled report date as a Unix timestamp.",
)

PROFITABILITY_STATUSES = (
    "PROFITABLE",
    "AT_RISK",
    "UNPROFITABLE",
)


# ============================================================
# SHARED SQL: FINAL FARE PER TRIP
# ============================================================

# Fare is cumulative while a trip is running (0.8 -> 2.1 -> 3.9 ...),
# so summing fare over every telemetry event over-counts earnings.
# Each trip must contribute only its final (maximum) fare, attributed
# to the zone and time of day where that final fare was recorded.
TRIP_FINAL_FARE_CTE = """
    trip_final AS (
        SELECT DISTINCT ON (trip_id)
            trip_id,
            zone,
            time_of_day,
            fare
        FROM telemetry_events
        WHERE trip_id IS NOT NULL
          AND trip_id <> ''
          AND zone IS NOT NULL
        ORDER BY
            trip_id,
            fare DESC,
            event_timestamp DESC
    )
"""


# ============================================================
# PROMETHEUS REQUEST MIDDLEWARE
# ============================================================

@app.middleware("http")
async def prometheus_middleware(request: Request, call_next):
    start_time = perf_counter()

    response = await call_next(request)

    duration = perf_counter() - start_time
    endpoint = request.url.path

    API_REQUESTS_TOTAL.labels(
        method=request.method,
        endpoint=endpoint,
        status=str(response.status_code),
    ).inc()

    API_REQUEST_DURATION.labels(
        method=request.method,
        endpoint=endpoint,
    ).observe(duration)

    return response


# ============================================================
# STARTUP HEALTH INITIALIZATION
# ============================================================

@app.on_event("startup")
def initialize_health_metrics():
    """
    Initialize API and database health metrics when the API starts.

    The API is considered healthy once FastAPI starts successfully.
    PostgreSQL connectivity is checked separately.
    """

    API_HEALTH_STATUS.set(1)

    try:
        conn = psycopg2.connect(
            host=os.getenv("POSTGRES_HOST", "localhost"),
            port=os.getenv("POSTGRES_PORT", "5432"),
            dbname=os.getenv("POSTGRES_DB", "ride_hailing"),
            user=os.getenv("POSTGRES_USER", "ride_admin"),
            password=os.getenv("POSTGRES_PASSWORD", "ride_password"),
            connect_timeout=5,
        )

        conn.close()

        DATABASE_HEALTH_STATUS.set(1)

    except Exception:
        DATABASE_HEALTH_STATUS.set(0)


# ============================================================
# FLEET PROMETHEUS METRIC REFRESH
# ============================================================

def update_fleet_prometheus_metrics():
    """
    Refresh fleet Prometheus gauges from the latest vehicle state
    stored in PostgreSQL.

    Each vehicle contributes only its most recent telemetry event.
    Metrics are grouped by the vehicle's current zone.
    """

    conn = None

    try:
        conn = get_connection()

        query = """
            SELECT
                zone,
                COUNT(*) FILTER (
                    WHERE status IN ('idle', 'enroute', 'on_trip')
                ) AS active_vehicles,

                COUNT(*) FILTER (
                    WHERE status = 'idle'
                ) AS idle_vehicles,

                COUNT(*) FILTER (
                    WHERE status = 'enroute'
                ) AS enroute_vehicles,

                COUNT(*) FILTER (
                    WHERE status = 'on_trip'
                ) AS on_trip_vehicles

            FROM (
                SELECT DISTINCT ON (vehicle_id)
                    vehicle_id,
                    zone,
                    status,
                    event_timestamp

                FROM telemetry_events

                WHERE zone IS NOT NULL

                ORDER BY
                    vehicle_id,
                    event_timestamp DESC
            ) latest_vehicle_state

            GROUP BY zone

            ORDER BY zone;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        # Remove previous zone label values so that stale zones
        # cannot remain in Prometheus.
        FLEET_ACTIVE_VEHICLES.clear()
        FLEET_IDLE_VEHICLES.clear()
        FLEET_ENROUTE_VEHICLES.clear()
        FLEET_ON_TRIP_VEHICLES.clear()

        for row in rows:
            zone = row[0]

            FLEET_ACTIVE_VEHICLES.labels(
                zone=zone
            ).set(row[1] or 0)

            FLEET_IDLE_VEHICLES.labels(
                zone=zone
            ).set(row[2] or 0)

            FLEET_ENROUTE_VEHICLES.labels(
                zone=zone
            ).set(row[3] or 0)

            FLEET_ON_TRIP_VEHICLES.labels(
                zone=zone
            ).set(row[4] or 0)

    except Exception as exc:
        print(
            f"FLEET_METRICS_UPDATE_ERROR error={exc}"
        )

    finally:
        if conn:
            conn.close()


# ============================================================
# EARNINGS PROMETHEUS METRIC REFRESH
# ============================================================

def update_earnings_prometheus_metrics():
    """
    Refresh trips/earnings gauges by zone and time of day.

    Each trip contributes only its final (maximum) fare.
    """

    conn = None

    try:
        conn = get_connection()

        query = f"""
            WITH {TRIP_FINAL_FARE_CTE}

            SELECT
                zone,
                time_of_day,
                COUNT(*) AS trips,
                COALESCE(SUM(fare), 0) AS earnings
            FROM trip_final
            GROUP BY zone, time_of_day
            ORDER BY zone, time_of_day;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        # Remove previous label values so that stale
        # zone/time_of_day combinations cannot remain.
        FLEET_TRIPS_TOTAL.clear()
        FLEET_EARNINGS_TOTAL.clear()

        for zone, time_of_day, trips, earnings in rows:

            FLEET_TRIPS_TOTAL.labels(
                zone=zone,
                time_of_day=time_of_day,
            ).set(trips or 0)

            FLEET_EARNINGS_TOTAL.labels(
                zone=zone,
                time_of_day=time_of_day,
            ).set(float(earnings or 0))

    except Exception as exc:
        print(
            f"EARNINGS_METRICS_UPDATE_ERROR error={exc}"
        )

    finally:
        if conn:
            conn.close()


# ============================================================
# PROFITABILITY PROMETHEUS METRIC REFRESH
# ============================================================

def update_profitability_prometheus_metrics():
    """
    Refresh profitability gauges from the most recent report date
    in vehicle_profitability (written by the Airflow reconciliation).
    """

    conn = None

    try:
        conn = get_connection()

        query = """
            SELECT
                vehicle_id,
                report_date,
                earnings,
                operating_cost,
                profit,
                profit_margin,
                service_flag,
                profitability_status
            FROM vehicle_profitability
            WHERE report_date = (
                SELECT MAX(report_date)
                FROM vehicle_profitability
            )
            ORDER BY vehicle_id;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        VEHICLE_PROFIT.clear()
        VEHICLE_PROFIT_MARGIN.clear()

        status_counts = {
            status: 0
            for status in PROFITABILITY_STATUSES
        }

        service_required = 0
        total_earnings = 0.0
        total_operating_cost = 0.0

        for (
            vehicle_id,
            report_date,
            earnings,
            operating_cost,
            profit,
            profit_margin,
            service_flag,
            status,
        ) in rows:

            VEHICLE_PROFIT.labels(
                vehicle_id=vehicle_id
            ).set(float(profit or 0))

            if profit_margin is not None:
                VEHICLE_PROFIT_MARGIN.labels(
                    vehicle_id=vehicle_id
                ).set(float(profit_margin))

            status_counts[status] = (
                status_counts.get(status, 0) + 1
            )

            if service_flag == "SERVICE_REQUIRED":
                service_required += 1

            total_earnings += float(earnings or 0)
            total_operating_cost += float(operating_cost or 0)

        for status, count in status_counts.items():
            VEHICLES_BY_PROFITABILITY_STATUS.labels(
                status=status
            ).set(count)

        VEHICLES_SERVICE_REQUIRED.set(service_required)
        FLEET_DAILY_EARNINGS.set(total_earnings)
        FLEET_DAILY_OPERATING_COST.set(total_operating_cost)

        if rows:
            report_date = rows[0][1]

            PROFITABILITY_REPORT_DATE.set(
                datetime.combine(
                    report_date,
                    datetime.min.time(),
                    tzinfo=timezone.utc,
                ).timestamp()
            )

    except Exception as exc:
        print(
            f"PROFITABILITY_METRICS_UPDATE_ERROR error={exc}"
        )

    finally:
        if conn:
            conn.close()


# ============================================================
# HEALTH ENDPOINT
# ============================================================

@app.get("/health")
def health_check():
    """
    Application and database health check.
    """

    conn = None

    try:
        conn = get_connection()

        with conn.cursor() as cursor:
            cursor.execute("SELECT CURRENT_TIMESTAMP;")
            timestamp = cursor.fetchone()[0]

        API_HEALTH_STATUS.set(1)
        DATABASE_HEALTH_STATUS.set(1)

        return {
            "status": "healthy",
            "database": "healthy",
            "timestamp": timestamp,
        }

    except Exception as exc:

        API_HEALTH_STATUS.set(0)
        DATABASE_HEALTH_STATUS.set(0)

        raise HTTPException(
            status_code=503,
            detail={
                "status": "unhealthy",
                "database": "unavailable",
                "error": str(exc),
            },
        )

    finally:
        if conn:
            conn.close()


# ============================================================
# FLEET UTILIZATION
# ============================================================

@app.get("/fleet/utilization")
def fleet_utilization():
    """
    Return current fleet utilization by zone.
    """

    conn = None

    try:
        conn = get_connection()

        query = f"""
            WITH latest_vehicle_state AS (
                SELECT DISTINCT ON (vehicle_id)
                    vehicle_id,
                    zone,
                    status,
                    event_timestamp
                FROM telemetry_events
                WHERE zone IS NOT NULL
                ORDER BY vehicle_id, event_timestamp DESC
            ),

            zone_states AS (
                SELECT
                    zone,

                    COUNT(*) FILTER (
                        WHERE status IN ('idle', 'enroute', 'on_trip')
                    ) AS active_vehicles,

                    COUNT(*) FILTER (
                        WHERE status = 'idle'
                    ) AS idle_vehicles,

                    COUNT(*) FILTER (
                        WHERE status = 'enroute'
                    ) AS enroute_vehicles,

                    COUNT(*) FILTER (
                        WHERE status = 'on_trip'
                    ) AS on_trip_vehicles

                FROM latest_vehicle_state
                GROUP BY zone
            ),

            {TRIP_FINAL_FARE_CTE},

            zone_activity AS (
                SELECT
                    zone,
                    COUNT(*) AS trips,
                    COALESCE(SUM(fare), 0) AS earnings
                FROM trip_final
                GROUP BY zone
            )

            SELECT
                zs.zone,
                zs.active_vehicles,
                zs.idle_vehicles,
                zs.enroute_vehicles,
                zs.on_trip_vehicles,

                CASE
                    WHEN zs.active_vehicles > 0
                    THEN ROUND(
                        zs.idle_vehicles::numeric
                        / zs.active_vehicles,
                        4
                    )
                    ELSE 0
                END AS idle_ratio,

                COALESCE(za.trips, 0) AS trips,
                COALESCE(za.earnings, 0) AS earnings

            FROM zone_states zs

            LEFT JOIN zone_activity za
                ON zs.zone = za.zone

            ORDER BY zs.zone;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        result = []

        for row in rows:
            result.append(
                {
                    "zone": row[0],
                    "active_vehicles": row[1],
                    "idle_vehicles": row[2],
                    "enroute_vehicles": row[3],
                    "on_trip_vehicles": row[4],
                    "idle_ratio": float(row[5] or 0),
                    "trips": row[6],
                    "earnings": float(row[7] or 0),
                }
            )

        return result

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )

    finally:
        if conn:
            conn.close()


# ============================================================
# FLEET EARNINGS
# ============================================================

@app.get("/fleet/earnings")
def fleet_earnings():
    """
    Return fleet trips and earnings grouped by zone and time of day.

    Each trip contributes only its final (maximum) fare.
    """

    conn = None

    try:
        conn = get_connection()

        query = f"""
            WITH {TRIP_FINAL_FARE_CTE}

            SELECT
                zone,
                time_of_day,
                COUNT(*) AS trips,
                COALESCE(SUM(fare), 0) AS earnings
            FROM trip_final
            GROUP BY
                zone,
                time_of_day
            ORDER BY
                zone,
                time_of_day;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        result = []

        for row in rows:
            result.append(
                {
                    "zone": row[0],
                    "time_of_day": row[1],
                    "trips": row[2],
                    "earnings": round(float(row[3] or 0), 2),
                }
            )

        return result

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )

    finally:
        if conn:
            conn.close()


# ============================================================
# VEHICLE PROFITABILITY
# ============================================================

@app.get("/vehicles/profitability")
def vehicle_profitability(
    limit: int = Query(
        default=25,
        ge=1,
        le=100,
    )
):
    """
    Return daily vehicle profitability reconciliation.
    """

    conn = None

    try:
        conn = get_connection()

        query = """
            SELECT
                vehicle_id,
                report_date,
                earnings,
                fuel_cost,
                maintenance_cost,
                operating_cost,
                profit,
                profit_margin,
                distance_covered,
                service_flag,
                profitability_status,
                calculated_at
            FROM vehicle_profitability
            ORDER BY
                report_date DESC,
                vehicle_id
            LIMIT %s;
        """

        with conn.cursor() as cursor:
            cursor.execute(query, (limit,))
            rows = cursor.fetchall()

        result = []

        for row in rows:
            result.append(
                {
                    "vehicle_id": row[0],
                    "report_date": row[1],
                    "earnings": float(row[2] or 0),
                    "fuel_cost": float(row[3] or 0),
                    "maintenance_cost": float(row[4] or 0),
                    "operating_cost": float(row[5] or 0),
                    "profit": float(row[6] or 0),
                    "profit_margin": (
                        float(row[7])
                        if row[7] is not None
                        else None
                    ),
                    "distance_covered": float(
                        row[8] or 0
                    ),
                    "service_flag": row[9],
                    "profitability_status": row[10],
                    "calculated_at": row[11],
                }
            )

        return result

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )

    finally:
        if conn:
            conn.close()


# ============================================================
# ALERTS
# ============================================================

@app.get("/alerts")
def alerts():
    """
    Return vehicles that currently require service attention.
    """

    conn = None

    try:
        conn = get_connection()

        query = """
            SELECT
                vehicle_id,
                report_date,
                service_flag,
                profitability_status,
                profit,
                profit_margin
            FROM vehicle_profitability
            WHERE service_flag <> 'OK'
               OR profitability_status IN (
                    'AT_RISK',
                    'UNPROFITABLE'
               )
            ORDER BY
                report_date DESC,
                vehicle_id;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        result = []

        for row in rows:
            result.append(
                {
                    "vehicle_id": row[0],
                    "report_date": row[1],
                    "service_flag": row[2],
                    "profitability_status": row[3],
                    "profit": float(row[4] or 0),
                    "profit_margin": (
                        float(row[5])
                        if row[5] is not None
                        else None
                    ),
                }
            )

        return result

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )

    finally:
        if conn:
            conn.close()


# ============================================================
# DAILY PROFITABILITY REPORT
# ============================================================

@app.get("/reports/daily/latest")
def latest_daily_report():
    """
    Consolidated daily profitability report for the most recently
    reconciled simulated day: fleet totals, status breakdown and the
    vehicles that became unprofitable once costs were applied.
    """

    conn = None

    try:
        conn = get_connection()

        query = """
            SELECT
                vehicle_id,
                report_date,
                earnings,
                operating_cost,
                profit,
                profit_margin,
                service_flag,
                profitability_status
            FROM vehicle_profitability
            WHERE report_date = (
                SELECT MAX(report_date)
                FROM vehicle_profitability
            )
            ORDER BY profit ASC;
        """

        with conn.cursor() as cursor:
            cursor.execute(query)
            rows = cursor.fetchall()

        if not rows:
            raise HTTPException(
                status_code=404,
                detail="No reconciled profitability report yet.",
            )

        status_counts = {
            status: 0
            for status in PROFITABILITY_STATUSES
        }

        vehicles = []

        for row in rows:
            status_counts[row[7]] = (
                status_counts.get(row[7], 0) + 1
            )

            vehicles.append(
                {
                    "vehicle_id": row[0],
                    "earnings": round(float(row[2] or 0), 2),
                    "operating_cost": round(float(row[3] or 0), 2),
                    "profit": round(float(row[4] or 0), 2),
                    "profit_margin": (
                        round(float(row[5]), 2)
                        if row[5] is not None
                        else None
                    ),
                    "service_flag": row[6],
                    "profitability_status": row[7],
                }
            )

        total_earnings = sum(v["earnings"] for v in vehicles)
        total_cost = sum(v["operating_cost"] for v in vehicles)

        return {
            "report_date": rows[0][1],
            "vehicles": len(vehicles),
            "fleet_earnings": round(total_earnings, 2),
            "fleet_operating_cost": round(total_cost, 2),
            "fleet_profit": round(total_earnings - total_cost, 2),
            "status_counts": status_counts,
            "unprofitable_vehicles": [
                v["vehicle_id"]
                for v in vehicles
                if v["profitability_status"] == "UNPROFITABLE"
            ],
            "at_risk_vehicles": [
                v["vehicle_id"]
                for v in vehicles
                if v["profitability_status"] == "AT_RISK"
            ],
            "vehicles_detail": vehicles,
        }

    except HTTPException:
        raise

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )

    finally:
        if conn:
            conn.close()


# ============================================================
# PROMETHEUS METRICS ENDPOINT
# ============================================================

@app.get(
    "/metrics",
    include_in_schema=False,
)
def metrics():
    """
    Prometheus scrape endpoint.

    Before returning metrics, refresh the fleet state, earnings
    and profitability business metrics from PostgreSQL.
    """

    update_fleet_prometheus_metrics()
    update_earnings_prometheus_metrics()
    update_profitability_prometheus_metrics()

    return Response(
        content=generate_latest(),
        media_type=CONTENT_TYPE_LATEST,
    )
